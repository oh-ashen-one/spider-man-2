// Homage fan game. Not an official Marvel, Sony or Insomniac game; no affiliation.
// P1 City, round 09: canyon shade fill + sky reflection for the city materials (hand-written; NOT generated by gen_shaders.mjs).
//
// Why: the r08 critic found every shadowed facade crushed (S1 crops mean Y 20-22 against the CITY-SPEC C2 floor of 52, S3 72 % / S7 62 % of the frame below Y 25).
// Causes: (1) Lumen sees only a slit of sky inside a 30 m avenue, so shaded walls get almost no indirect light (P4 owns GI / exposure: logged in docs/night1/city/HANDOFF.md);
// (2) the r07 albedo cap (SunK) is keyed on N.L, it cannot know about shadows, so a west wall that faces the sun but sits in canyon shade gets the low cap AND no sun.
// Fix: an emissive term = the surface's own albedo (before the sun cap, lifted ^0.65) x a constant 'sky bounce' irradiance (what the opposite lit facades and the sky strip deliver to a canyon
// wall), tinted by the sun height (warm and weaker at sunset), faded out over 0.9-2.2 km (the far skyline keeps its tuned C11-C15 look) and by (1 - NightK).
// A material cannot read the shadow map, so where the fill applies comes from a baked building HEIGHT FIELD (tools/export/bake_sunmask.py -> Textures/sunmask_h, 1 m texels, R/G = height in 0.02 m,
// B = height / 400 m for the mips): CityShadeW = CityEnclosure (1 on the canyon floor .. 0 above the local skyline, mean height from mips 5 / 7) x (1 - 0.88 x CitySunLit), CitySunLit = 20-step
// ray march toward the sun. Sunlit or open-air surfaces keep 12 % / 0 % of the fill: the first version added it everywhere and blew sunlit facades (S2 gold glass mean Y 133, S8 pale glass 148,
// C1 clipping on an S8 brick face).
// Strengths are MPC_City scalars (ShadeFill, GlassSky): change them without recompiling (tools/export/ue/set_mpc.py). Facade DebugMode 12 shows the weight (blue = full fill, red = none).
#ifndef CITY_SHADEFILL_USH
#define CITY_SHADEFILL_USH

// height field extents (UE X / Y in metres = browser x / z), must match tools/export/bake_sunmask.py
#define CITY_SM_X0 (-384.0)
#define CITY_SM_Y0 (-640.0)
#define CITY_SM_SIZE 1024.0

// 1 = the surface faces the sun AND no building blocks the ray, 0 = shaded (facing away or in a canyon shadow). Soft edge ~ +-(0.03 t + 0.75) m around the occluder's top.
float CitySunLit(Texture2D tH, SamplerState sH, float3 wpos, float3 n, float3 sunDir)
{
    float3 L = normalize(sunDir);
    float nl = dot(n, L);
    if (nl <= 0.0 || L.z < 0.02) return 0.0;
    float3 P = wpos * 0.01 + n * 0.8;
    float vis = 1.0;
    float t = 2.0;
    [loop] for (int i = 0; i < 20; i++)
    {
        float3 q = P + L * t;
        float2 uv = (q.xy - float2(CITY_SM_X0, CITY_SM_Y0)) * (1.0 / CITY_SM_SIZE);
        float4 h4 = Texture2DSampleLevel(tH, sH, uv, 0.0);
        float hh = (h4.r * 255.0 * 256.0 + h4.g * 255.0) * 0.02;
        vis = min(vis, saturate((q.z - hh) / (0.06 * t + 1.5) + 0.5));
        t *= 1.3;
        if (vis < 0.02) break;
    }
    return vis * smoothstep(0.0, 0.3, nl);
}

// mean building height (m) around the point in a 32 m and a 128 m window (mips 5 / 7 of the B channel, manual bilinear because the asset is point-filtered)
float CityMeanH(Texture2D tH, SamplerState sH, float2 uv, float mip)
{
    float sz = CITY_SM_SIZE / exp2(mip);
    float2 f = uv * sz - 0.5;
    float2 i0 = floor(f);
    float2 w = f - i0;
    float2 u0 = clamp((i0 + 0.5) / sz, 0.0, 1.0);
    float2 u1 = clamp((i0 + 1.5) / sz, 0.0, 1.0);
    float a = Texture2DSampleLevel(tH, sH, float2(u0.x, u0.y), mip).b;
    float b = Texture2DSampleLevel(tH, sH, float2(u1.x, u0.y), mip).b;
    float c = Texture2DSampleLevel(tH, sH, float2(u0.x, u1.y), mip).b;
    float d = Texture2DSampleLevel(tH, sH, float2(u1.x, u1.y), mip).b;
    return lerp(lerp(a, b, w.x), lerp(c, d, w.x), w.y) * 400.0;
}

// 1 at the canyon floor, falling to 0 at 1.2 x the mean roof height around the point: Lumen already delivers real sky light to walls above the local skyline (aerial views), the fill only makes up
// for what a narrow canyon hides
float CityEnclosure(Texture2D tH, SamplerState sH, float3 wpos)
{
    float2 uv = (wpos.xy * 0.01 - float2(CITY_SM_X0, CITY_SM_Y0)) * (1.0 / CITY_SM_SIZE);
    float hm = 0.5 * (CityMeanH(tH, sH, uv, 5.0) + CityMeanH(tH, sH, uv, 7.0));
    float h = wpos.z * 0.01;
    return saturate(1.0 - (h - 0.3 * hm) / (0.9 * hm + 8.0));
}

// weight of the fill: enclosure x (1 - 0.88 x sunlit): full in a shaded canyon, 12 % where the sun reaches, ~0 above the skyline. Early outs (perf): fill switched off (k = 0), beyond the 2.2 km fade,
// above the skyline (enclosure < 0.02), and the march stops as soon as the ray is blocked.
float CityShadeW(Texture2D tH, SamplerState sH, float3 wpos, float3 n, float3 sunDir, float3 cam, float k)
{
    if (k <= 0.0001 || length(wpos - cam) > 220000.0) return 0.0;
    float enc = CityEnclosure(tH, sH, wpos);
    if (enc < 0.02) return 0.0;
    return enc * (1.0 - 0.88 * CitySunLit(tH, sH, wpos, n, sunDir));
}

// alb: base colour BEFORE the sun-facing cap; n: world normal (UE Z up); wpos / cam: world cm; sunDir: ResolvedView.DirectionalLightDirection.xyz; k: MPC ShadeFill
float3 CityShadeFill(float3 alb, float3 n, float3 wpos, float3 cam, float3 sunDir, float k, float nightk, float shadeW)
{
    float dist = length(wpos - cam) * 0.01;
    float nearF = 1.0 - smoothstep(900.0, 2200.0, dist);
    float hM = wpos.z * 0.01;
    float skyW = saturate(0.62 + 0.38 * n.z);
    float open = lerp(0.72, 1.0, smoothstep(2.0, 80.0, hM));
    float lowSun = smoothstep(0.04, 0.45, saturate(abs(sunDir.z)));
    float3 sky = lerp(float3(1.0, 0.70, 0.48), float3(0.80, 0.90, 1.0), lowSun);
    float amount = k * skyW * open * lerp(0.55, 1.0, lowSun) * nearF * (1.0 - saturate(nightk)) * shadeW;
    float3 al = pow(max(alb, float3(0.0, 0.0, 0.0)), 0.65);
    return al * sky * amount;
}

// f: mirror tint (F0) of the glass; the reflected ray sees a sky gradient (horizon -> zenith) and, looking down, the lit upper part of the opposite facade
float3 CitySkyRefl(float3 f, float3 n, float3 wpos, float3 cam, float3 sunDir, float k, float nightk, float shadeW)
{
    float dist = length(wpos - cam) * 0.01;
    float nearF = 1.0 - smoothstep(900.0, 2200.0, dist);
    float3 V = normalize(cam - wpos);
    float3 R = reflect(-V, n);
    float lowSun = smoothstep(0.04, 0.45, saturate(abs(sunDir.z)));
    float3 zen = lerp(float3(0.65, 0.42, 0.30), float3(0.22, 0.40, 0.85), lowSun);
    float3 hor = lerp(float3(1.0, 0.62, 0.38), float3(0.62, 0.74, 0.92), lowSun);
    float3 sky = lerp(hor, zen, saturate(R.z * 1.6));
    float vis = lerp(0.35, 1.0, smoothstep(-0.5, 0.35, R.z));
    float graze = 1.0 + pow(saturate(1.0 - dot(n, V)), 3.0);
    return f * sky * vis * graze * (k * nearF * (1.0 - saturate(nightk)) * shadeW);
}
#endif
