// ---- GLSL compatibility (tools/export/glsl2hlsl.mjs)
float  gmod(float x, float y)   { return x - y * floor(x / y); }
float2 gmod(float2 x, float y)  { return x - y * floor(x / y); }
float3 gmod(float3 x, float y)  { return x - y * floor(x / y); }
