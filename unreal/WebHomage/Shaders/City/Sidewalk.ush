        float3 nz = tNoise.Sample(tNoiseSampler, fl2(p / 53.0)).rgb;
        float d = min(min(p.x - vRect.x, vRect.z - p.x), min(p.y - vRect.y, vRect.w - p.y));
        if (vWN.y < 0.5) {
          // curb face: weathered concrete/granite, dirtier near the gutter
          float2 q = float2(p.x + p.y,vWP.y) / 1.3;
          float3 c = tCurb.Sample(tCurbSampler, fl2(q)).rgb * 0.92; // (textures r2) $imagegen granite curbstone (was the sidewalk sheet)
          c *= 1.0 - curbJ(TEXPASS, p.x + p.y, fwP.x + fwP.y); // 2.4 m stone joints
          c *= lerp(0.55, 1.0, smoothstep(-0.02, 0.14, vWP.y));
          sR = 0.85; sN = float3(0.0,0.0,1.0);
          return c;
        }
        float2 uv = p / 6.0; // (textures) imagegen sidewalk sheet holds 4 x 4 slabs -> 1.5 m (5 ft) NYC slabs
        float3 c = tCol.Sample(tColSampler, fl2(uv)).rgb;
        float3 n = tNrm.Sample(tNrmSampler, fl2(uv)).rgb;
        float curb = 1.0 - smoothstep(0.26, 0.3, d);
        if (curb > 0.0) {
