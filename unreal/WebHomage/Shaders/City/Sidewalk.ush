static float3 vWP; static float3 vRoad; static float4 vRect; static float3 vWN; static float3 gCamPos;
    varying float4 vRect; varying float3 vWP; varying float3 vWN;
      static float3 sN; static float sR;
      float curbJ(TEXDECL, float a, float fw) { float x = abs(frac(a / 2.4) - 0.5) * 2.4, w = max(0.012, fw * 1.5); return 0.45 * smoothstep(1.2 - w, 1.2, x) * (0.012 / w); } // (textures r2) curbstone joints, AA
