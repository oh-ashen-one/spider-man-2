        }
        sR = lerp(n.b, 1.0, smoothstep(300.0, 1100.0, length(vWP - gCamPos))); // (r13) matte from afar (no grazing glare strips)
        float2 nxy = n.rg * 2.0 - 1.0; sN = normalize(float3(nxy,sqrt(max(0.0, 1.0 - dot(nxy, nxy)))));
